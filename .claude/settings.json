{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lua_check_dispatch.sh"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "additionalDirectories": [
            "~/p/arc.nvim",
            "~/p/debugmaster.nvim",
            "~/p/fzf-pin.nvim",
            "~/p/liter.nvim",
            "~/p/no-tmux.nvim",
            "~/p/pcre.nvim"
        ],
        "allow": [
            "Bash(./tests/run.sh)",
            "Bash(./tests/run.sh --quick)",
            "Bash(tests/run.sh)"
        ]
    }
}
