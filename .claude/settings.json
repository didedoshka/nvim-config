{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "apply_patch|Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/lua-check.py\" \"$HOME/p\"",
                        "timeout": 600,
                        "statusMessage": "Checking Lua"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "additionalDirectories": [
            "~/p/arc.nvim",
            "~/p/debugmaster.nvim",
            "~/p/fzf-pin.nvim",
            "~/p/liter.nvim",
            "~/p/no-tmux.nvim",
            "~/p/pcre.nvim"
        ],
        "allow": [
            "Bash(./tests/run.sh)",
            "Bash(./tests/run.sh --quick)",
            "Bash(tests/run.sh)"
        ]
    }
}
